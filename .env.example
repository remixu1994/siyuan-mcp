NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# none: anonymous mode; read-only unless anonymous writes and a notebook allowlist are both enabled
# fixed: all tools, for MCP clients that can send a custom Authorization header
# oauth: all tools for ChatGPT GUI, using JWT access tokens from an OAuth 2.1 provider
# mock-oauth: temporary in-process OAuth with PKCE and an access-code page; not for production
AUTH_MODE=fixed
ANONYMOUS_WRITE_ENABLED=false
MCP_FIXED_TOKEN=replace-with-at-least-32-random-characters

# Required by oauth and mock-oauth
MCP_PUBLIC_URL=https://siyuan-mcp.example.com
OAUTH_SCOPES=siyuan.read siyuan.write

# Required only when AUTH_MODE=oauth
OAUTH_ISSUER_URL=https://your-tenant.example.com/
OAUTH_AUDIENCE=https://siyuan-mcp.example.com
OAUTH_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json

# Required only when AUTH_MODE=mock-oauth
MOCK_OAUTH_CLIENT_ID=chatgpt-siyuan-mcp
MOCK_OAUTH_REDIRECT_URI=https://chatgpt.com/connector/oauth/replace-with-current-callback-id
MOCK_OAUTH_ACCESS_CODE=replace-with-at-least-32-random-characters
MOCK_OAUTH_TOKEN_TTL_SECONDS=3600

SIYUAN_BASE_URL=https://siyuan.example.com
SIYUAN_TOKEN=replace-with-siyuan-api-token
# Comma- or whitespace-separated SiYuan notebook IDs. Denylist takes precedence.
# An empty allowlist means all notebooks, except in anonymous write mode where it is forbidden.
SIYUAN_NOTEBOOK_ALLOWLIST=
SIYUAN_NOTEBOOK_DENYLIST=
SIYUAN_TIMEOUT_MS=20000
SIYUAN_READ_RETRIES=2
